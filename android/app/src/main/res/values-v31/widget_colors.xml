<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the surface and text follow the phone's Material You
     palette, like system widgets; the ring colours stay the app's own. -->
<resources>
    <color name="widget_surface">@android:color/system_neutral1_50</color>
    <color name="widget_on_surface">@android:color/system_neutral1_900</color>
    <color name="widget_on_surface_variant">@android:color/system_neutral2_700</color>
    <color name="widget_heart">#E11D48</color>
    <color name="widget_steps">#2563EB</color>
    <color name="widget_momentum">#B45309</color>
    <color name="widget_locked_track">#1F1B1B21</color>
</resources>
