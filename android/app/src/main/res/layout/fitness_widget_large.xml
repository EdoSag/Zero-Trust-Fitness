<?xml version="1.0" encoding="utf-8"?>
<!-- 3x2 and bigger: header, rings on the left, the numbers and Momentum on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fitness_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_app_name"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_today"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/widget_ring"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:maxHeight="140dp"
                android:scaleType="fitCenter"
                android:src="@drawable/fitness_widget_preview_ring" />

            <ImageView
                android:id="@+id/widget_ring_lock"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/widget_locked_short"
                android:src="@drawable/ic_widget_lock"
                android:tint="@color/widget_on_surface_variant"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widget_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/widget_heart_points"
                    android:src="@drawable/ic_widget_heart"
                    android:tint="@color/widget_heart" />

                <TextView
                    android:id="@+id/widget_hp_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="15"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="22sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_hp_goal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="of 21 Heart Pts"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/widget_steps"
                    android:src="@drawable/ic_widget_steps"
                    android:tint="@color/widget_steps" />

                <TextView
                    android:id="@+id/widget_steps_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="5,480"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="22sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_steps_goal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="of 10,000 steps"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_locked_msg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:maxLines="3"
            android:text="@string/widget_locked"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_momentum_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_bolt"
            android:tint="@color/widget_momentum" />

        <TextView
            android:id="@+id/widget_momentum"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Momentum 64 · Building"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
