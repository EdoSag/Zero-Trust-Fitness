<?xml version="1.0" encoding="utf-8"?>
<!-- One row tall (2x1 up to 5x1): small rings, then Heart Points and steps. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/ZtWidget.Root"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="14dp"
    android:paddingBottom="6dp">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/widget_ring"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:maxHeight="72dp"
            android:scaleType="fitCenter"
            android:src="@drawable/fitness_widget_preview_ring" />

        <ImageView
            android:id="@+id/widget_ring_lock"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:contentDescription="@string/widget_locked_short"
            android:src="@drawable/ic_zt_widget_lock"
            android:tint="@color/zt_widget_on_surface_variant"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/widget_stats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/widget_heart_points"
                    android:src="@drawable/ic_widget_heart"
                    android:tint="@color/widget_heart" />

                <TextView
                    android:id="@+id/widget_hp_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="15"
                    android:textColor="@color/zt_widget_on_surface"
                    android:textSize="17sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_hp_goal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="of 21 Heart Pts"
                android:textColor="@color/zt_widget_on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_steps_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/widget_steps"
                    android:src="@drawable/ic_widget_steps"
                    android:tint="@color/widget_steps" />

                <TextView
                    android:id="@+id/widget_steps_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="5,480"
                    android:textColor="@color/zt_widget_on_surface"
                    android:textSize="17sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_steps_goal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="of 10,000 steps"
                android:textColor="@color/zt_widget_on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_locked_msg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/widget_locked"
        android:textColor="@color/zt_widget_on_surface_variant"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
